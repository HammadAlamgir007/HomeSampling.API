-- sp_GetActiveTasksByRider
CREATE OR ALTER PROCEDURE sp_GetActiveTasksByRider
    @RiderId INT
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        a.AppointmentId,
        a.UserId,
        u.Username  AS PatientName,
        u.Email     AS PatientPhone, -- using email as contact until phone added to Users
        t.Name      AS TestName,
        a.Address,
        a.Latitude,
        a.Longitude,
        a.Status,
        a.ScheduledDate
    FROM Appointments a
    JOIN Users u ON u.UserId = a.UserId
    JOIN Tests t ON t.TestId = a.TestId
    WHERE a.RiderId = @RiderId
      AND a.Status IN (2, 3, 4, 5) -- AssignedRider, OnWay, Arrived, Collected
    ORDER BY a.ScheduledDate ASC;
END
