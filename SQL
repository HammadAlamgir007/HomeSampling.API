-- sp_InsertTaskLog
CREATE OR ALTER PROCEDURE sp_InsertTaskLog
    @AppointmentId INT,
    @RiderId       INT,
    @Action        NVARCHAR(50),
    @Notes         NVARCHAR(1000) = NULL,
    @PhotoPath     NVARCHAR(500)  = NULL,
    @Latitude      FLOAT          = NULL,
    @Longitude     FLOAT          = NULL
AS
BEGIN
    SET NOCOUNT ON;
    INSERT INTO TaskLogs
        (AppointmentId, RiderId, Action, Notes, PhotoPath, Latitude, Longitude)
    VALUES
        (@AppointmentId, @RiderId, @Action, @Notes, @PhotoPath, @Latitude, @Longitude);

    -- When delivered, mark rider as Available again
    IF @Action = 'Delivered'
    BEGIN
        UPDATE Riders SET Status = 0 WHERE RiderId = @RiderId;

        -- Notify the patient
        DECLARE @UserId INT;
        SELECT @UserId = UserId FROM Appointments WHERE AppointmentId = @AppointmentId;

        INSERT INTO Notifications (RecipientId, RecipientType, AppointmentId, Title, Body)
        VALUES (
            @UserId,
            'User',
            @AppointmentId,
            'Sample Delivered',
            'Your sample has been delivered to the lab. Your report will be ready soon.'
        );
    END

    -- When collected, notify patient
    IF @Action = 'Collected'
    BEGIN
        DECLARE @UserId2 INT;
        SELECT @UserId2 = UserId FROM Appointments WHERE AppointmentId = @AppointmentId;

        INSERT INTO Notifications (RecipientId, RecipientType, AppointmentId, Title, Body)
        VALUES (
            @UserId2,
            'User',
            @AppointmentId,
            'Sample Collected',
            'Your sample has been successfully collected and is on its way to the lab.'
        );
    END
END
GO

-- sp_UpdateRiderLocation
CREATE OR ALTER PROCEDURE sp_UpdateRiderLocation
    @RiderId   INT,
    @Latitude  FLOAT,
    @Longitude FLOAT,
    @Status    INT
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE Riders
    SET LastLatitude   = @Latitude,
        LastLongitude  = @Longitude,
        LastLocationAt = GETUTCDATE(),
        Status         = @Status
    WHERE RiderId = @RiderId;
END
GO

-- sp_GetRiderNotifications
CREATE OR ALTER PROCEDURE sp_GetRiderNotifications
    @RiderId INT
AS
BEGIN
    SET NOCOUNT ON;
    SELECT NotificationId, Title, Body, IsRead, CreatedAt
    FROM Notifications
    WHERE RecipientId   = @RiderId
      AND RecipientType = 'Rider'
    ORDER BY CreatedAt DESC;
END
GO

-- sp_MarkNotificationRead
CREATE OR ALTER PROCEDURE sp_MarkNotificationRead
    @NotificationId INT,
    @RiderId        INT
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE Notifications
    SET IsRead = 1
    WHERE NotificationId = @NotificationId
      AND RecipientId    = @RiderId
      AND RecipientType  = 'Rider';
END
GO

