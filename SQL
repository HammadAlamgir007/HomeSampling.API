-- sp_IncrementLoginAttempts
CREATE OR ALTER PROCEDURE sp_IncrementLoginAttempts
    @Email NVARCHAR(255)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE Users
    SET LoginAttempts = LoginAttempts + 1,
        IsLocked = CASE WHEN LoginAttempts + 1 >= 5 THEN 1 ELSE 0 END
    WHERE Email = @Email;
END
