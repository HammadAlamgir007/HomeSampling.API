-- sp_GetTaskHistoryByRider
CREATE OR ALTER PROCEDURE sp_GetTaskHistoryByRider
    @RiderId INT
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        a.AppointmentId,
        a.UserId,
        u.Username  AS PatientName,
        u.Email     AS PatientPhone,
        t.Name      AS TestName,
        a.Address,
        a.Latitude,
        a.Longitude,
        a.Status,
        a.ScheduledDate
    FROM Appointments a
    JOIN Users u ON u.UserId = a.UserId
    JOIN Tests t ON t.TestId = a.TestId
    WHERE a.RiderId = @RiderId
      AND a.Status IN (6, 7, 8) -- Delivered, ReportUploaded, Cancelled
    ORDER BY a.ScheduledDate DESC;
END
