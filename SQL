-- sp_GetDashboardStats
CREATE OR ALTER PROCEDURE sp_GetDashboardStats
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        (SELECT COUNT(*) FROM Users WHERE Role = 'Patient')                             AS TotalPatients,
        (SELECT COUNT(*) FROM Appointments WHERE Status != 8)                           AS TotalAppointments,
        (SELECT COUNT(*) FROM Appointments WHERE Status = 0)                            AS PendingAppointments,
        (SELECT COUNT(*) FROM Appointments WHERE Status = 6
            AND CAST(ScheduledDate AS DATE) = CAST(GETUTCDATE() AS DATE))               AS CompletedToday,
        (SELECT COUNT(*) FROM Riders WHERE Status = 0)                                  AS ActiveRiders,
        (SELECT ISNULL(SUM(t.Price), 0)
         FROM Appointments a
         JOIN Tests t ON t.TestId = a.TestId
         WHERE a.Status IN (6, 7)
           AND YEAR(a.ScheduledDate) = YEAR(GETUTCDATE())
           AND MONTH(a.ScheduledDate) = MONTH(GETUTCDATE()))                            AS RevenueThisMonth;
END
GO

-- sp_GetAppointmentsPaged
CREATE OR ALTER PROCEDURE sp_GetAppointmentsPaged
    @Page    INT,
    @PerPage INT,
    @Search  NVARCHAR(100) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        a.AppointmentId,
        a.UserId,
        u.Username  AS PatientName,
        u.Email,
        t.Name      AS TestName,
        a.Status,
        a.ScheduledDate,
        a.Address,
        r.Name      AS RiderName,
        a.RiderId,
        a.ReportFileName,
        COUNT(*) OVER () AS TotalCount
    FROM Appointments a
    JOIN Users  u ON u.UserId   = a.UserId
    JOIN Tests  t ON t.TestId   = a.TestId
    LEFT JOIN Riders r ON r.RiderId = a.RiderId
    WHERE a.Status != 8
      AND (
          @Search IS NULL
          OR u.Username LIKE '%' + @Search + '%'
          OR u.Email    LIKE '%' + @Search + '%'
          OR t.Name     LIKE '%' + @Search + '%'
      )
    ORDER BY a.CreatedAt DESC
    OFFSET (@Page - 1) * @PerPage ROWS
    FETCH NEXT @PerPage ROWS ONLY;
END
GO

