-- sp_GetAppointmentByDate (duplicate check)
CREATE OR ALTER PROCEDURE sp_GetAppointmentByDate
    @UserId INT,
    @TestId INT,
    @Date   DATE
AS
BEGIN
    SET NOCOUNT ON;
    SELECT TOP 1
        a.AppointmentId, a.UserId, a.TestId, t.Name AS TestName,
        a.RiderId, a.Status, a.ScheduledDate, a.Address,
        a.Latitude, a.Longitude, a.ReportFileName, a.ReportUploadedAt, a.CreatedAt
    FROM Appointments a
    JOIN Tests t ON t.TestId = a.TestId
    WHERE a.UserId = @UserId
      AND a.TestId = @TestId
      AND CAST(a.ScheduledDate AS DATE) = @Date
      AND a.Status != 8; -- not cancelled
END
GO

