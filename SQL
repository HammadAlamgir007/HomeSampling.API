-- 2. CREATE TABLES
-- ─────────────────────────────────────────────

-- Users (Patients + Admins)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'Users')
BEGIN
    CREATE TABLE Users (
        UserId        INT           IDENTITY(1,1) PRIMARY KEY,
        Username      NVARCHAR(100) NOT NULL,
        Email         NVARCHAR(255) NOT NULL UNIQUE,
        PasswordHash  NVARCHAR(500) NOT NULL,
        Role          NVARCHAR(20)  NOT NULL DEFAULT 'Patient', -- Patient | Admin
        IsLocked      BIT           NOT NULL DEFAULT 0,
        LoginAttempts INT           NOT NULL DEFAULT 0,
        CreatedAt     DATETIME2     NOT NULL DEFAULT GETUTCDATE()
    );
END
GO

-- OTPs (for register and password reset)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'Otps')
BEGIN
    CREATE TABLE Otps (
        OtpId     INT           IDENTITY(1,1) PRIMARY KEY,
        Email     NVARCHAR(255) NOT NULL,
        Code      NVARCHAR(10)  NOT NULL,
        Purpose   NVARCHAR(50)  NOT NULL, -- Register | ResetPassword
        ExpiresAt DATETIME2     NOT NULL,
        IsUsed    BIT           NOT NULL DEFAULT 0,
        CreatedAt DATETIME2     NOT NULL DEFAULT GETUTCDATE()
    );
END
GO

-- Tests (lab test catalog)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'Tests')
BEGIN
    CREATE TABLE Tests (
        TestId      INT            IDENTITY(1,1) PRIMARY KEY,
        Name        NVARCHAR(200)  NOT NULL,
        Description NVARCHAR(1000) NOT NULL,
        Price       DECIMAL(10,2)  NOT NULL,
        Duration    INT            NOT NULL, -- duration in minutes
        IsActive    BIT            NOT NULL DEFAULT 1,
        CreatedAt   DATETIME2      NOT NULL DEFAULT GETUTCDATE()
    );
END
GO

-- Riders (field workers)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'Riders')
BEGIN
    CREATE TABLE Riders (
        RiderId        INT           IDENTITY(1,1) PRIMARY KEY,
        Name           NVARCHAR(100) NOT NULL,
        Email          NVARCHAR(255) NOT NULL UNIQUE,
        PasswordHash   NVARCHAR(500) NOT NULL,
        Phone          NVARCHAR(20)  NOT NULL,
        PhotoPath      NVARCHAR(500) NULL,
        Status         INT           NOT NULL DEFAULT 0, -- 0=Available 1=Busy 2=Offline
        LastLatitude   FLOAT         NULL,
        LastLongitude  FLOAT         NULL,
        LastLocationAt DATETIME2     NULL,
        CreatedAt      DATETIME2     NOT NULL DEFAULT GETUTCDATE()
    );
END
GO

-- Appointments (central booking table)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'Appointments')
BEGIN
    CREATE TABLE Appointments (
        AppointmentId    INT            IDENTITY(1,1) PRIMARY KEY,
        UserId           INT            NOT NULL FOREIGN KEY REFERENCES Users(UserId),
        TestId           INT            NOT NULL FOREIGN KEY REFERENCES Tests(TestId),
        RiderId          INT            NULL     FOREIGN KEY REFERENCES Riders(RiderId),
        Status           INT            NOT NULL DEFAULT 0,
        -- 0=Pending 1=Confirmed 2=AssignedRider 3=OnWay
        -- 4=Arrived 5=Collected 6=Delivered 7=ReportUploaded 8=Cancelled
        ScheduledDate    DATETIME2      NOT NULL,
        Address          NVARCHAR(500)  NOT NULL,
        Latitude         FLOAT          NULL,
        Longitude        FLOAT          NULL,
        ReportFileName   NVARCHAR(500)  NULL,
        ReportUploadedAt DATETIME2      NULL,
        CreatedAt        DATETIME2      NOT NULL DEFAULT GETUTCDATE()
    );
END
GO

-- TaskLogs (immutable audit trail of rider actions)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'TaskLogs')
BEGIN
    CREATE TABLE TaskLogs (
        LogId         INT            IDENTITY(1,1) PRIMARY KEY,
        AppointmentId INT            NOT NULL FOREIGN KEY REFERENCES Appointments(AppointmentId),
        RiderId       INT            NOT NULL FOREIGN KEY REFERENCES Riders(RiderId),
        Action        NVARCHAR(50)   NOT NULL, -- OnWay | Arrived | Collected | Delivered
        Notes         NVARCHAR(1000) NULL,
        PhotoPath     NVARCHAR(500)  NULL,
        Latitude      FLOAT          NULL,
        Longitude     FLOAT          NULL,
        CreatedAt     DATETIME2      NOT NULL DEFAULT GETUTCDATE()
    );
END
GO

-- Notifications (for riders and patients)
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'Notifications')
BEGIN
    CREATE TABLE Notifications (
        NotificationId INT           IDENTITY(1,1) PRIMARY KEY,
        RecipientId    INT           NOT NULL,  -- UserId or RiderId depending on RecipientType
        RecipientType  NVARCHAR(10)  NOT NULL,  -- User | Rider
        AppointmentId  INT           NULL FOREIGN KEY REFERENCES Appointments(AppointmentId),
        Title          NVARCHAR(200) NOT NULL,
        Body           NVARCHAR(500) NOT NULL,
        IsRead         BIT           NOT NULL DEFAULT 0,
        CreatedAt      DATETIME2     NOT NULL DEFAULT GETUTCDATE()
    );
END
