-- 1. CREATE DATABASE
-- ─────────────────────────────────────────────
IF NOT EXISTS (SELECT name FROM sys.databases WHERE name = 'HomeSamplingDB')
BEGIN
    CREATE DATABASE HomeSamplingDB;
END
GO

