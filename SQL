-- sp_BulkUpdateStatus
CREATE OR ALTER PROCEDURE sp_BulkUpdateStatus
    @AppointmentIds NVARCHAR(MAX), -- comma-separated IDs e.g. '1,2,3'
    @Status         INT
AS
BEGIN
    SET NOCOUNT ON;

    -- Split comma-separated IDs using STRING_SPLIT (SQL Server 2016+)
    UPDATE Appointments
    SET Status = @Status
    WHERE AppointmentId IN (
        SELECT CAST(value AS INT)
        FROM STRING_SPLIT(@AppointmentIds, ',')
    );
END
GO

-- sp_AssignRider (manual assignment)
CREATE OR ALTER PROCEDURE sp_AssignRider
    @AppointmentId INT,
    @RiderId       INT
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE Appointments
    SET RiderId = @RiderId,
        Status  = 2 -- AssignedRider
    WHERE AppointmentId = @AppointmentId;

    -- Update rider status to Busy
    UPDATE Riders
    SET Status = 1 -- Busy
    WHERE RiderId = @RiderId;

    -- Insert notification for the rider
    INSERT INTO Notifications (RecipientId, RecipientType, AppointmentId, Title, Body)
    VALUES (
        @RiderId,
        'Rider',
        @AppointmentId,
        'New Task Assigned',
        'You have been assigned a new sample collection task. Please check your tasks.'
    );
END
GO

-- sp_AutoAssignRider (finds nearest available rider)
CREATE OR ALTER PROCEDURE sp_AutoAssignRider
    @AppointmentId INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @AppLat  FLOAT;
    DECLARE @AppLng  FLOAT;
    DECLARE @RiderId INT;

    -- Get appointment coordinates
    SELECT @AppLat = Latitude, @AppLng = Longitude
    FROM Appointments
    WHERE AppointmentId = @AppointmentId;

    -- Find the nearest available rider using Haversine-style distance
    -- If appointment has no GPS, just pick any available rider
    SELECT TOP 1 @RiderId = r.RiderId
    FROM Riders r
    WHERE r.Status = 0 -- Available
    ORDER BY
        CASE
            WHEN @AppLat IS NOT NULL AND @AppLng IS NOT NULL
                 AND r.LastLatitude IS NOT NULL AND r.LastLongitude IS NOT NULL
            THEN
                -- Approximate distance in km (Haversine simplified)
                SQRT(
                    POWER((@AppLat - r.LastLatitude) * 111.0, 2) +
                    POWER((@AppLng - r.LastLongitude) * 111.0 * COS(RADIANS(@AppLat)), 2)
                )
            ELSE 0
        END ASC,
        r.CreatedAt ASC; -- Tiebreak: longest-registered rider

    IF @RiderId IS NOT NULL
    BEGIN
        -- Assign the rider
        UPDATE Appointments
        SET RiderId = @RiderId,
            Status  = 2 -- AssignedRider
        WHERE AppointmentId = @AppointmentId;

        -- Mark rider as busy
        UPDATE Riders
        SET Status = 1 -- Busy
        WHERE RiderId = @RiderId;

        -- Notify rider
        INSERT INTO Notifications (RecipientId, RecipientType, AppointmentId, Title, Body)
        VALUES (
            @RiderId,
            'Rider',
            @AppointmentId,
            'New Task Assigned',
            'You have been auto-assigned a new sample collection task.'
        );
    END

    SELECT @RiderId AS AssignedRiderId;
END
GO

-- sp_SaveReportPath
CREATE OR ALTER PROCEDURE sp_SaveReportPath
    @AppointmentId  INT,
    @ReportFileName NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE Appointments
    SET ReportFileName   = @ReportFileName,
        ReportUploadedAt = GETUTCDATE(),
        Status           = 7 -- ReportUploaded
    WHERE AppointmentId = @AppointmentId;

    -- Notify patient
    DECLARE @UserId INT;
    SELECT @UserId = UserId FROM Appointments WHERE AppointmentId = @AppointmentId;

    INSERT INTO Notifications (RecipientId, RecipientType, AppointmentId, Title, Body)
    VALUES (
        @UserId,
        'User',
        @AppointmentId,
        'Report Ready',
        'Your lab report is ready. You can now download it from your dashboard.'
    );
END
GO

